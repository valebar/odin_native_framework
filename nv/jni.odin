#+build linux:android
package nv

// Minimal JNI binding. Function indices follow `struct JNINativeInterface` in the NDK's jni.h.
//
// Java members are reached through the typed wrappers in jni_api_android.odin, generated by
// android/jnigen from nv/android/jni_api.txt and verified against android.jar, so no descriptor is
// hand-written here. A wrapper calls jni_new_object / jni_call_* / jni_get_*_field with a
// `Jni_Method` / `Jni_Field`, which resolves its class (a global ref) and ID once on first use; a
// method ID from the declaring class is valid for instances of its subclasses.

import "base:intrinsics"

jobject   :: distinct rawptr
jclass    :: jobject
jstring   :: jobject
jmethodID :: distinct rawptr
jfieldID  :: distinct rawptr
jint      :: i32
jlong     :: i64
jboolean  :: u8

jvalue :: struct #raw_union {
	z: jboolean,
	i: jint,
	j: jlong,
	f: f32,
	d: f64,
	l: jobject,
}

// JNIEnv* = pointer to the function table pointer.
JNI_Env :: ^[^]rawptr

// A Java class by JNI name ("android/view/View"); `ref` is filled on first use.
Jni_Class :: struct {
	name: cstring,
	ref:  jclass, // global ref
}

// A method of `cls` by name and descriptor; `id` is filled on first use.
Jni_Method :: struct {
	cls:    ^Jni_Class,
	name:   cstring,
	sig:    cstring,
	static: bool,
	id:     jmethodID,
}

// An instance field of `cls`; `id` is filled on first use.
Jni_Field :: struct {
	cls:  ^Jni_Class,
	name: cstring,
	sig:  cstring,
	id:   jfieldID,
}

@(private) JNI_FIND_CLASS            :: 6
@(private) JNI_EXCEPTION_DESCRIBE    :: 16
@(private) JNI_EXCEPTION_CLEAR       :: 17
@(private) JNI_NEW_GLOBAL_REF        :: 21
@(private) JNI_DELETE_GLOBAL_REF     :: 22
@(private) JNI_DELETE_LOCAL_REF      :: 23
@(private) JNI_NEW_OBJECT_A          :: 30
@(private) JNI_GET_METHOD_ID         :: 33
@(private) JNI_CALL_OBJECT_METHOD_A  :: 36
@(private) JNI_CALL_BOOLEAN_METHOD_A :: 39
@(private) JNI_CALL_INT_METHOD_A     :: 51
@(private) JNI_CALL_FLOAT_METHOD_A   :: 57
@(private) JNI_CALL_VOID_METHOD_A    :: 63
@(private) JNI_GET_FIELD_ID          :: 94
@(private) JNI_GET_INT_FIELD         :: 100
@(private) JNI_GET_FLOAT_FIELD       :: 102
@(private) JNI_GET_STATIC_METHOD_ID  :: 113
@(private) JNI_CALL_STATIC_OBJECT_A  :: 116
@(private) JNI_CALL_STATIC_VOID_A    :: 143
@(private) JNI_GET_STATIC_FIELD_ID    :: 144
@(private) JNI_GET_STATIC_INT_FIELD   :: 150
@(private) JNI_NEW_STRING_UTF        :: 167
@(private) JNI_GET_STRING_UTF_LENGTH :: 168
@(private) JNI_GET_STRING_UTF_CHARS  :: 169
@(private) JNI_RELEASE_STRING_UTF_CHARS :: 170
@(private) JNI_GET_ARRAY_LENGTH      :: 171
@(private) JNI_NEW_BYTE_ARRAY        :: 176
@(private) JNI_GET_BYTE_ARRAY_REGION :: 200
@(private) JNI_SET_BYTE_ARRAY_REGION :: 208
@(private) JNI_EXCEPTION_CHECK       :: 228

@(private)
jni_fn :: #force_inline proc "contextless" (env: JNI_Env, $T: typeid, index: int) -> T {
	if env == nil do jni_no_env()
	return cast(T)env^[index]
}

// g_android.env is nil until an onCreate stored it. A JNI call before that (from the app's main,
// say: a bitmap, a font or an asset read before nv.run) stops here with a log line instead of
// crashing at address 0.
@(private, cold)
jni_no_env :: proc "contextless" () -> ! {
	__android_log_write(ANDROID_LOG_ERROR, "nv", "JNI call before an onCreate stored an env (from the app's main?)")
	intrinsics.trap()
}

jni_find_class :: proc "contextless" (env: JNI_Env, name: cstring) -> jclass {
	return jni_fn(env, proc "c" (JNI_Env, cstring) -> jclass, JNI_FIND_CLASS)(env, name)
}

jni_new_global_ref :: proc "contextless" (env: JNI_Env, obj: jobject) -> jobject {
	return jni_fn(env, proc "c" (JNI_Env, jobject) -> jobject, JNI_NEW_GLOBAL_REF)(env, obj)
}

jni_delete_global_ref :: proc "contextless" (env: JNI_Env, obj: jobject) {
	jni_fn(env, proc "c" (JNI_Env, jobject), JNI_DELETE_GLOBAL_REF)(env, obj)
}

jni_delete_local_ref :: proc "contextless" (env: JNI_Env, obj: jobject) {
	jni_fn(env, proc "c" (JNI_Env, jobject), JNI_DELETE_LOCAL_REF)(env, obj)
}

// The class's global ref, found on the first call. nil (after logging the exception) when the
// class is missing, which the build-time check against android.jar rules out for the spec.
jni_class_ref :: proc "contextless" (env: JNI_Env, c: ^Jni_Class) -> jclass {
	if c.ref == nil {
		local := jni_find_class(env, c.name)
		if local == nil {
			jni_check(env)
			return nil
		}
		c.ref = jni_new_global_ref(env, local)
		jni_delete_local_ref(env, local)
	}
	return c.ref
}

// The method's ID, looked up on the first call; nil (logged) when the class or method is missing.
jni_method_id :: proc "contextless" (env: JNI_Env, m: ^Jni_Method) -> jmethodID {
	if m.id == nil {
		cls := jni_class_ref(env, m.cls)
		if cls == nil do return nil
		index := m.static ? JNI_GET_STATIC_METHOD_ID : JNI_GET_METHOD_ID
		m.id = jni_fn(env, proc "c" (JNI_Env, jclass, cstring, cstring) -> jmethodID, index)(env, cls, m.name, m.sig)
		if m.id == nil do jni_check(env)
	}
	return m.id
}

// The field's ID, looked up on the first call; nil (logged) when the class or field is missing.
jni_field_id :: proc "contextless" (env: JNI_Env, f: ^Jni_Field) -> jfieldID {
	if f.id == nil {
		cls := jni_class_ref(env, f.cls)
		if cls == nil do return nil
		f.id = jni_fn(env, proc "c" (JNI_Env, jclass, cstring, cstring) -> jfieldID, JNI_GET_FIELD_ID)(env, cls, f.name, f.sig)
		if f.id == nil do jni_check(env)
	}
	return f.id
}

// A new instance through the constructor `m` (name "<init>"); a local ref, nil on failure.
jni_new_object :: proc "contextless" (env: JNI_Env, m: ^Jni_Method, args: ..jvalue) -> jobject {
	id := jni_method_id(env, m)
	if id == nil do return nil
	obj := jni_fn(env, proc "c" (JNI_Env, jclass, jmethodID, [^]jvalue) -> jobject, JNI_NEW_OBJECT_A)(env, m.cls.ref, id, raw_data(args))
	jni_check(env)
	return obj
}

// Instance calls. A static `m` is called on its class and `obj` is ignored.
jni_call_object :: proc "contextless" (env: JNI_Env, obj: jobject, m: ^Jni_Method, args: ..jvalue) -> jobject {
	id := jni_method_id(env, m)
	if id == nil do return nil
	index := m.static ? JNI_CALL_STATIC_OBJECT_A : JNI_CALL_OBJECT_METHOD_A
	res := jni_fn(env, proc "c" (JNI_Env, jobject, jmethodID, [^]jvalue) -> jobject, index)(env, m.static ? jobject(m.cls.ref) : obj, id, raw_data(args))
	jni_check(env)
	return res
}

jni_call_void :: proc "contextless" (env: JNI_Env, obj: jobject, m: ^Jni_Method, args: ..jvalue) {
	id := jni_method_id(env, m)
	if id == nil do return
	index := m.static ? JNI_CALL_STATIC_VOID_A : JNI_CALL_VOID_METHOD_A
	jni_fn(env, proc "c" (JNI_Env, jobject, jmethodID, [^]jvalue), index)(env, m.static ? jobject(m.cls.ref) : obj, id, raw_data(args))
	jni_check(env)
}

jni_call_float :: proc "contextless" (env: JNI_Env, obj: jobject, m: ^Jni_Method, args: ..jvalue) -> f32 {
	id := jni_method_id(env, m)
	if id == nil do return 0
	res := jni_fn(env, proc "c" (JNI_Env, jobject, jmethodID, [^]jvalue) -> f32, JNI_CALL_FLOAT_METHOD_A)(env, obj, id, raw_data(args))
	jni_check(env)
	return res
}

jni_call_bool :: proc "contextless" (env: JNI_Env, obj: jobject, m: ^Jni_Method, args: ..jvalue) -> bool {
	id := jni_method_id(env, m)
	if id == nil do return false
	res := jni_fn(env, proc "c" (JNI_Env, jobject, jmethodID, [^]jvalue) -> jboolean, JNI_CALL_BOOLEAN_METHOD_A)(env, obj, id, raw_data(args))
	jni_check(env)
	return res != 0
}

jni_call_int :: proc "contextless" (env: JNI_Env, obj: jobject, m: ^Jni_Method, args: ..jvalue) -> jint {
	id := jni_method_id(env, m)
	if id == nil do return 0
	res := jni_fn(env, proc "c" (JNI_Env, jobject, jmethodID, [^]jvalue) -> jint, JNI_CALL_INT_METHOD_A)(env, obj, id, raw_data(args))
	jni_check(env)
	return res
}

jni_get_int_field :: proc "contextless" (env: JNI_Env, obj: jobject, f: ^Jni_Field) -> jint {
	id := jni_field_id(env, f)
	if id == nil do return 0
	return jni_fn(env, proc "c" (JNI_Env, jobject, jfieldID) -> jint, JNI_GET_INT_FIELD)(env, obj, id)
}

jni_get_float_field :: proc "contextless" (env: JNI_Env, obj: jobject, f: ^Jni_Field) -> f32 {
	id := jni_field_id(env, f)
	if id == nil do return 0
	return jni_fn(env, proc "c" (JNI_Env, jobject, jfieldID) -> f32, JNI_GET_FLOAT_FIELD)(env, obj, id)
}

// A new byte[] holding a copy of `data`; a local ref.
jni_byte_array :: proc "contextless" (env: JNI_Env, data: []u8) -> jobject {
	arr := jni_fn(env, proc "c" (JNI_Env, jint) -> jobject, JNI_NEW_BYTE_ARRAY)(env, jint(len(data)))
	jni_fn(env, proc "c" (JNI_Env, jobject, jint, jint, [^]u8), JNI_SET_BYTE_ARRAY_REGION)(env, arr, 0, jint(len(data)), raw_data(data))
	return arr
}

// Copies a byte[]; nil for a null array.
jni_bytes_clone :: proc(env: JNI_Env, arr: jobject, allocator := context.allocator) -> []u8 {
	if arr == nil do return nil
	n := jni_fn(env, proc "c" (JNI_Env, jobject) -> jint, JNI_GET_ARRAY_LENGTH)(env, arr)
	out := make([]u8, n, allocator)
	jni_fn(env, proc "c" (JNI_Env, jobject, jint, jint, [^]u8), JNI_GET_BYTE_ARRAY_REGION)(env, arr, 0, n, raw_data(out))
	return out
}

// Reads a static int field by class and field name, such as an android.R resource id whose name
// is only known at run time; 0 when the class or field is missing.
jni_get_static_int_field :: proc "contextless" (env: JNI_Env, cls_name, name: cstring) -> jint {
	cls := jni_find_class(env, cls_name)
	if cls == nil {
		jni_check(env)
		return 0
	}
	defer jni_delete_local_ref(env, cls)
	id := jni_fn(env, proc "c" (JNI_Env, jclass, cstring, cstring) -> jfieldID, JNI_GET_STATIC_FIELD_ID)(env, cls, name, "I")
	if id == nil {
		jni_check(env)
		return 0
	}
	res := jni_fn(env, proc "c" (JNI_Env, jclass, jfieldID) -> jint, JNI_GET_STATIC_INT_FIELD)(env, cls, id)
	jni_check(env)
	return res
}

jni_string :: proc "contextless" (env: JNI_Env, s: cstring) -> jstring {
	return jni_fn(env, proc "c" (JNI_Env, cstring) -> jstring, JNI_NEW_STRING_UTF)(env, s)
}

// Copies a Java string (as modified UTF-8, which only differs from UTF-8 for NUL and
// characters outside the BMP).
jni_string_clone :: proc(env: JNI_Env, s: jstring, allocator := context.allocator) -> string {
	n := jni_fn(env, proc "c" (JNI_Env, jstring) -> jint, JNI_GET_STRING_UTF_LENGTH)(env, s)
	chars := jni_fn(env, proc "c" (JNI_Env, jstring, ^jboolean) -> [^]u8, JNI_GET_STRING_UTF_CHARS)(env, s, nil)
	defer jni_fn(env, proc "c" (JNI_Env, jstring, [^]u8), JNI_RELEASE_STRING_UTF_CHARS)(env, s, chars)
	out := make([]u8, n, allocator)
	copy(out, chars[:n])
	return string(out)
}

// Logs and clears a pending Java exception so later JNI calls stay valid.
jni_check :: proc "contextless" (env: JNI_Env) {
	if jni_fn(env, proc "c" (JNI_Env) -> jboolean, JNI_EXCEPTION_CHECK)(env) != 0 {
		jni_fn(env, proc "c" (JNI_Env), JNI_EXCEPTION_DESCRIBE)(env)
		jni_fn(env, proc "c" (JNI_Env), JNI_EXCEPTION_CLEAR)(env)
	}
}

jv_obj    :: #force_inline proc "contextless" (o: jobject) -> jvalue { return {l = o} }
jv_int    :: #force_inline proc "contextless" (i: int) -> jvalue { return {i = jint(i)} }
jv_long   :: #force_inline proc "contextless" (i: i64) -> jvalue { return {j = jlong(i)} }
jv_float  :: #force_inline proc "contextless" (f: f32) -> jvalue { return {f = f} }
jv_double :: #force_inline proc "contextless" (d: f64) -> jvalue { return {d = d} }
jv_bool   :: #force_inline proc "contextless" (b: bool) -> jvalue { return {z = jboolean(b)} }
